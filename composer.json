{
  "name": "tinywan/storage",
  "description": "webman storage plugin",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=7.2",
    "workerman/webman-framework": "^1.5.4||^2.0"
  },
  "autoload": {
    "psr-4": {
      "Tinywan\\Storage\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tinywan\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "workerman/webman": "^1.0",
    "carthage-software/mago": "^1.47",
    "pestphp/pest": "^3.8",
    "aliyuncs/oss-sdk-php": "^2.4",
    "qcloud/cos-sdk-v5": "^2.5",
    "qiniu/php-sdk": "^7.4",
    "league/flysystem-aws-s3-v3": "^1.0"
  },
  "scripts": {
    "format:check": "mago format --check",
    "format": "mago format",
    "lint": "mago lint",
    "analyse": "mago analyze",
    "test": "pest",
    "check": [
        "@format:check",
        "@lint",
        "@analyse",
        "@test"
    ]
  },
  "config": {
    "allow-plugins": {
        "carthage-software/mago": true,
        "pestphp/pest-plugin": true
    },
    "sort-packages": true
  }
}
